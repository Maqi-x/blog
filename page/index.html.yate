<!DOCTYPE html>
<html>
  <head>
    <title>Example</title>
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <p>Posts:</p>
    <ul>
      $for (const BlPost* post = blog.begin; post < blog.end; ++post) {
        <li>
          <a href="posts/${ escape(post->meta.id); }$.html">
            $escape(post->meta.title);
          </a>
        </li>
      $}
    </ul>
  </body>
</html>
