<!DOCTYPE html>
<html>
  <head>
    <title>Example</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Clarity+City:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <p>Posts:</p>
    <ul>
      $for (const BlPost* post = blog.begin; post < blog.end; ++post) {
        <li>
          <a href="posts/${ escape(post->meta.id); }$">
            $escape(post->meta.title);
          </a>
        </li>
      $}
    </ul>
  </body>
</html>

<!-- vim: set expandtab ts=2 sw=2 sts=2 : -->
