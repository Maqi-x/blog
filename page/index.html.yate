<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Example</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Clarity+City:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="$/index.css">
  </head>
  <body>
    $#include "navbar.html.h"
    <main class="posts-page">
      <h1>Posts</h1>
      <div class="post-tiles">
      $for (const BlPost* post = blog.begin; post < blog.end; ++post) {
        <a class="post-tile" href="posts/${ escape(post->meta.id); }$">
          <h2>${ escape(post->meta.title); }$</h2>
          <p>${ escape(post->meta.desc); }$</p>
        </a>
      $}
      </div>
    </main>
  </body>
</html>

<!-- vim: set expandtab ts=2 sw=2 sts=2 : -->
